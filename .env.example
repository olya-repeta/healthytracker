# Root Environment Variables Example (for Docker Compose & Production Setup)

# Backend Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super-secret-wellness-jwt-key-change-in-prod
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vitatrack?schema=public"

# Google OAuth 2.0 Configuration (do not wrap value in quotes)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Frontend Configuration
VITE_API_URL=http://localhost:4000/api
# Do not wrap in quotes to prevent literal quotes in frontend build
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
