# Root Environment Variables Example (for Docker Compose & Local Setup)

# Backend Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super-secret-wellness-jwt-key-change-in-prod
JWT_EXPIRES_IN=7d

# Database Configuration
# For local quick start with SQLite:
DATABASE_URL="file:./dev.db"
# For PostgreSQL (Docker / Production):
# DATABASE_URL="postgresql://medtracker:medtracker_pass@postgres:5432/medtracker_db?schema=public"

# Frontend Configuration
VITE_API_URL=http://localhost:4000/api
